# Server Configuration
PORT=5000
NODE_ENV=development

# Gemini AI API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Gemini Model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK Configuration (Optional for production, demo mode works locally)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend Firebase Web App Config (Optional, demo auth mode works out of the box)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
