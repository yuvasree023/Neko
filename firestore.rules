rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if request matches current user's UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Match the user document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Match all journal entries nested under the authenticated user
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Match user profile / settings
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Disallow all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
